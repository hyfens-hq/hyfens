[Unit]
Description=Check freshness of the public control-plane backup in Cloudflare R2
Wants=network-online.target
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/hyfens-public-control-plane-dev-backup check-freshness
TimeoutStartSec=10min
