#!/bin/sh
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

usage() {
  cat >&2 <<'EOF'
Usage:
  hyfens-public-control-plane-dev-backup create
  hyfens-public-control-plane-dev-backup list
  hyfens-public-control-plane-dev-backup check-freshness

The runner snapshots the public control-plane PostgreSQL database and its
digest-addressed R2 objects to a separate managed backup prefix. It never
restores data or processes a deletion request.
EOF
}

fail() {
  echo "public control-plane managed backup failed: $*" >&2
  exit 1
}

[ "$(id -u)" -eq 0 ] || fail 'must run as root'
[ "$#" -ge 1 ] || { usage; exit 2; }

operation=$1
shift
stage=/opt/hyfens/public-control-plane-dev
compose_file="$stage/deploy/p2/docker-compose.public-control-plane-dev.yml"
env_file=/etc/hyfens/public-control-plane-dev.env
docker=/usr/bin/docker
project=hyfens-public-control-plane-dev
work_root=/var/lib/hyfens/public-control-plane-dev-backups
backup_prefix=operational/public-control-plane/
freshness_min_age_seconds=900
freshness_max_age_limit_seconds=2592000
postgres_image=postgres:17-alpine
work=''

cleanup() {
  set +e
  [ -n "$work" ] && rm -rf "$work"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

[ -x "$docker" ] || fail 'Docker is not installed at /usr/bin/docker'
[ -f "$compose_file" ] || fail 'installed public control-plane Compose manifest is missing'
[ "$(readlink -f "$compose_file")" = "$compose_file" ] || {
  fail 'installed public control-plane Compose manifest must not be a symlink'
}
[ -f "$env_file" ] || fail 'protected public control-plane environment is missing'
[ "$(stat -c '%U:%G %a' "$env_file")" = 'root:root 600' ] || {
  fail 'protected public control-plane environment must be root:root with mode 600'
}
[ -x /usr/bin/flock ] || fail 'flock is not installed at /usr/bin/flock'

require_setting() {
  name=$1
  grep -Eq "^[[:space:]]*$name[[:space:]]*=[[:space:]]*[^[:space:]]" "$env_file" || {
    fail "protected public control-plane environment is missing $name"
  }
}

setting() {
  name=$1
  value=$(sed -n "s/^[[:space:]]*$name[[:space:]]*=[[:space:]]*//p" "$env_file" | head -n 1)
  [ -n "$value" ] || fail "protected public control-plane environment is missing $name"
  printf '%s\n' "$value" | grep -Eq '^[^[:space:]]+$' || {
    fail "$name contains whitespace"
  }
  printf '%s' "$value"
}

https_setting() {
  name=$1
  value=$(setting "$name")
  case "$value" in
    https://*) ;;
    *) fail "$name must use HTTPS" ;;
  esac
  printf '%s' "$value"
}

bucket_setting() {
  name=$1
  value=$(setting "$name")
  printf '%s\n' "$value" | grep -Eq '^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$' || {
    fail "$name is invalid"
  }
  printf '%s' "$value"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command is missing: $1"
}

require_setting HYFENS_PUBLIC_BACKUP_SOURCE_ENDPOINT
require_setting HYFENS_PUBLIC_BACKUP_SOURCE_BUCKET
require_setting HYFENS_PUBLIC_BACKUP_SOURCE_ACCESS_KEY_ID
require_setting HYFENS_PUBLIC_BACKUP_SOURCE_SECRET_ACCESS_KEY
require_setting HYFENS_PUBLIC_BACKUP_DEST_ENDPOINT
require_setting HYFENS_PUBLIC_BACKUP_DEST_BUCKET
require_setting HYFENS_PUBLIC_BACKUP_DEST_ACCOUNT_ID
require_setting HYFENS_PUBLIC_BACKUP_DEST_ACCESS_KEY_ID
require_setting HYFENS_PUBLIC_BACKUP_DEST_SECRET_ACCESS_KEY
require_setting HYFENS_PUBLIC_BACKUP_MAX_AGE_SECONDS

source_endpoint=$(https_setting HYFENS_PUBLIC_BACKUP_SOURCE_ENDPOINT)
source_bucket=$(bucket_setting HYFENS_PUBLIC_BACKUP_SOURCE_BUCKET)
source_access_key=$(setting HYFENS_PUBLIC_BACKUP_SOURCE_ACCESS_KEY_ID)
source_secret_key=$(setting HYFENS_PUBLIC_BACKUP_SOURCE_SECRET_ACCESS_KEY)
destination_endpoint=$(https_setting HYFENS_PUBLIC_BACKUP_DEST_ENDPOINT)
destination_bucket=$(bucket_setting HYFENS_PUBLIC_BACKUP_DEST_BUCKET)
destination_account_id=$(setting HYFENS_PUBLIC_BACKUP_DEST_ACCOUNT_ID)
destination_access_key=$(setting HYFENS_PUBLIC_BACKUP_DEST_ACCESS_KEY_ID)
destination_secret_key=$(setting HYFENS_PUBLIC_BACKUP_DEST_SECRET_ACCESS_KEY)
max_age=$(setting HYFENS_PUBLIC_BACKUP_MAX_AGE_SECONDS)

printf '%s\n' "$destination_account_id" | grep -Eq '^[a-f0-9]{32}$' || {
  fail 'destination R2 account ID is invalid'
}
[ "$destination_endpoint" =
  "https://${destination_account_id}.r2.cloudflarestorage.com" ] || {
  fail 'destination R2 S3 endpoint must match the configured account'
}
[ "$destination_bucket" = hyfens-cloud-backups ] || {
  fail 'destination R2 bucket must be hyfens-cloud-backups'
}
printf '%s\n' "$max_age" | grep -Eq '^[1-9][0-9]*$' || {
  fail 'public backup freshness age must be a positive integer'
}
[ "$max_age" -ge "$freshness_min_age_seconds" ] &&
  [ "$max_age" -le "$freshness_max_age_limit_seconds" ] || {
  fail 'public backup freshness age is outside the supported range'
}

require_command awk
require_command date
require_command grep
require_command python3
require_command sha256sum
require_command sort
require_command tr

install -d -o root -g root -m 0755 /run/lock
exec 9>/run/lock/hyfens-public-control-plane-dev-backup.lock
case "$operation" in
  check-freshness)
    /usr/bin/flock -w 300 9 || fail 'another public backup operation did not finish in time'
    ;;
  create|list)
    /usr/bin/flock -n 9 || fail 'another public backup operation is already running'
    ;;
  *)
    usage
    exit 2
    ;;
esac

compose() {
  "$docker" compose \
    --profile managed-backup \
    --project-name "$project" \
    --file "$compose_file" \
    --env-file "$env_file" \
    "$@"
}

new_work() {
  install -d -o root -g root -m 0755 "$work_root"
  work=$(mktemp -d "$work_root/.work.XXXXXX")
  chmod 0700 "$work"
}

run_aws() {
  credential_source=$1
  shift
  case "$credential_source" in
    source)
      access_key=$source_access_key
      secret_key=$source_secret_key
      endpoint=$source_endpoint
      ;;
    destination)
      access_key=$destination_access_key
      secret_key=$destination_secret_key
      endpoint=$destination_endpoint
      ;;
    *)
      fail 'invalid object credential source'
      ;;
  esac
  aws_env_file="$work/aws.env"
  umask 077
  {
    printf 'AWS_ACCESS_KEY_ID=%s\n' "$access_key"
    printf 'AWS_SECRET_ACCESS_KEY=%s\n' "$secret_key"
    printf 'AWS_DEFAULT_REGION=auto\n'
    printf 'AWS_REGION=auto\n'
    printf 'AWS_PAGER=\n'
    printf 'AWS_EC2_METADATA_DISABLED=true\n'
    printf 'AWS_ENDPOINT_URL_S3=%s\n' "$endpoint"
  } > "$aws_env_file"
  chmod 0600 "$aws_env_file"
  compose run --rm --no-deps --no-TTY \
    --volume "$work:/backup:rw" \
    --user 0:0 \
    --env-from-file "$aws_env_file" \
    cloud-backup "$@" --endpoint-url "$endpoint" --region auto \
    2>"$work/aws.stderr" || {
    fail 'R2 object operation failed'
  }
}

wait_for_postgres() {
  attempt=0
  while ! compose exec -T postgres pg_isready \
    -U hyfens -d hyfens > /dev/null 2>&1; do
    attempt=$((attempt + 1))
    [ "$attempt" -lt 60 ] || fail 'public PostgreSQL did not become ready'
    sleep 1
  done
}

valid_backup_id() {
  printf '%s\n' "$1" | grep -Eq '^[0-9]{8}T[0-9]{6}Z$'
}

restore_list() {
  "$docker" run --rm --interactive --network none \
    --log-driver none --entrypoint pg_restore "$postgres_image" \
    --list < "$1" > /dev/null 2>/dev/null || return 1
}

write_object_manifest() {
  python3 - "$work/objects" "$work/objects-manifest.json" <<'PY'
import hashlib
import json
import os
import re
import sys

root, output = sys.argv[1:]
items = []
key_pattern = re.compile(r"^[A-Za-z0-9._/-]+$")
for directory, directories, files in os.walk(root):
    directories[:] = sorted(directories)
    for name in sorted(files):
        path = os.path.join(directory, name)
        if os.path.islink(path) or not os.path.isfile(path):
            raise SystemExit("object snapshot contains a non-regular file")
        key = os.path.relpath(path, root).replace(os.sep, "/")
        parts = key.split("/")
        if (not key_pattern.fullmatch(key) or key.startswith("../") or
            key == ".." or any(part in ("", ".", "..") for part in parts)):
            raise SystemExit("object snapshot contains an unsafe key")
        digest = hashlib.sha256()
        size = 0
        with open(path, "rb") as source:
            while chunk := source.read(1024 * 1024):
                digest.update(chunk)
                size += len(chunk)
        items.append({
            "key": key,
            "sha256": "sha256:" + digest.hexdigest(),
            "size_bytes": size,
        })
items.sort(key=lambda item: item["key"])
with open(output, "w", encoding="utf-8") as target:
    json.dump({"schema_version": 1, "objects": items}, target, indent=2)
    target.write("\n")
PY
}

verify_object_manifest() {
  python3 - "$1" "$2" <<'PY'
import hashlib
import json
import os
import re
import sys

manifest_path, root = sys.argv[1:]
try:
    with open(manifest_path, encoding="utf-8") as source:
        manifest = json.load(source)
    if not isinstance(manifest, dict) or manifest.get("schema_version") != 1:
        raise ValueError("schema")
    expected = manifest["objects"]
    if not isinstance(expected, list):
        raise ValueError("objects")
    expected_by_key = {}
    for item in expected:
        if not isinstance(item, dict):
            raise ValueError("object entry")
        key = item["key"]
        digest = item["sha256"]
        size = item["size_bytes"]
        if (not isinstance(key, str) or
            not re.fullmatch(r"[A-Za-z0-9._/-]+", key) or
            key.startswith("../") or key == ".." or
            any(part in ("", ".", "..") for part in key.split("/")) or
            not isinstance(digest, str) or
            not re.fullmatch(r"sha256:[0-9a-f]{64}", digest) or
            not isinstance(size, int) or size < 0 or key in expected_by_key):
            raise ValueError("invalid object entry")
        expected_by_key[key] = (digest[7:], size)

    actual = {}
    for directory, directories, files in os.walk(root):
        directories[:] = sorted(directories)
        for name in sorted(files):
            path = os.path.join(directory, name)
            if os.path.islink(path) or not os.path.isfile(path):
                raise ValueError("non-regular object")
            key = os.path.relpath(path, root).replace(os.sep, "/")
            if key in actual:
                raise ValueError("duplicate object")
            digest = hashlib.sha256()
            size = 0
            with open(path, "rb") as source:
                while chunk := source.read(1024 * 1024):
                    digest.update(chunk)
                    size += len(chunk)
            actual[key] = (digest.hexdigest(), size)
    if actual != expected_by_key:
        raise ValueError("object content does not match manifest")
except (KeyError, TypeError, ValueError, json.JSONDecodeError, OSError):
    raise SystemExit("object snapshot failed manifest verification")
PY
}

write_manifests() {
  python3 - "$work" "$1" "$source_bucket" <<'PY'
import hashlib
import json
import os
import sys

work, backup_id, source_bucket = sys.argv[1:]

def file_details(path):
    digest = hashlib.sha256()
    size = 0
    with open(path, "rb") as source:
        while chunk := source.read(1024 * 1024):
            digest.update(chunk)
            size += len(chunk)
    return {"sha256": "sha256:" + digest.hexdigest(), "size_bytes": size}

database = file_details(os.path.join(work, "postgres.dump"))
objects = file_details(os.path.join(work, "objects-manifest.json"))
with open(os.path.join(work, "objects-manifest.json"), encoding="utf-8") as source:
    object_manifest = json.load(source)
object_count = len(object_manifest["objects"])
database_key = f"operational/public-control-plane/{backup_id}/postgres.dump"
objects_key = f"operational/public-control-plane/{backup_id}/objects/manifest.json"
with open(os.path.join(work, "manifest.json"), "w", encoding="utf-8") as target:
    json.dump({
        "schema_version": 1,
        "backup_id": backup_id,
        "created_at": __import__("datetime").datetime.now(
            __import__("datetime").timezone.utc
        ).replace(microsecond=0).isoformat().replace("+00:00", "Z"),
        "source": "hyfens-public-control-plane",
        "source_bucket": source_bucket,
        "policy_prefix": "operational/",
        "retention_days": 30,
        "consistency": "operator_quiesced_pair_required",
        "database": {"key": database_key, **database},
        "objects": {
            "manifest_key": objects_key,
            "manifest_sha256": objects["sha256"],
            "manifest_size_bytes": objects["size_bytes"],
            "count": object_count,
        },
    }, target, indent=2)
    target.write("\n")
PY
}

manifest_values() {
  python3 - "$1" "$2" <<'PY'
import datetime as dt
import json
import re
import sys

path, expected_id = sys.argv[1:]
try:
    with open(path, encoding="utf-8") as source:
        value = json.load(source)
    if not isinstance(value, dict):
        raise ValueError("manifest object")
    if value.get("schema_version") != 1 or value.get("backup_id") != expected_id:
        raise ValueError("manifest identity")
    if value.get("policy_prefix") != "operational/" or value.get("retention_days") != 30:
        raise ValueError("retention policy")
    if value.get("consistency") != "operator_quiesced_pair_required":
        raise ValueError("consistency contract")
    created_at = value.get("created_at")
    if not isinstance(created_at, str) or not re.fullmatch(
        r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z",
        created_at,
    ):
        raise ValueError("created at")
    created = dt.datetime.fromisoformat(created_at[:-1] + "+00:00")
    age = int((dt.datetime.now(dt.timezone.utc) - created).total_seconds())
    if age < 0:
        raise ValueError("created at is in the future")
    database = value.get("database")
    objects = value.get("objects")
    if not isinstance(database, dict) or not isinstance(objects, dict):
        raise ValueError("backup sections")
    database_key = f"operational/public-control-plane/{expected_id}/postgres.dump"
    objects_key = f"operational/public-control-plane/{expected_id}/objects/manifest.json"
    if database.get("key") != database_key or objects.get("manifest_key") != objects_key:
        raise ValueError("backup keys")
    database_sha = database.get("sha256")
    objects_sha = objects.get("manifest_sha256")
    if (not isinstance(database_sha, str) or
        not re.fullmatch(r"sha256:[0-9a-f]{64}", database_sha) or
        not isinstance(objects_sha, str) or
        not re.fullmatch(r"sha256:[0-9a-f]{64}", objects_sha)):
        raise ValueError("backup digests")
    database_size = database.get("size_bytes")
    objects_size = objects.get("manifest_size_bytes")
    object_count = objects.get("count")
    if (not isinstance(database_size, int) or database_size <= 0 or
        not isinstance(objects_size, int) or objects_size <= 0 or
        not isinstance(object_count, int) or object_count < 0):
        raise ValueError("backup sizes")
    print("\t".join([
        database_key, database_sha[7:], str(database_size),
        objects_key, objects_sha[7:], str(objects_size), str(object_count),
        str(age),
    ]))
except (KeyError, TypeError, ValueError, json.JSONDecodeError, OSError):
    raise SystemExit("invalid public managed backup manifest")
PY
}

head_size() {
  credential_source=$1
  bucket=$2
  key=$3
  remote_size=$(run_aws "$credential_source" s3api head-object \
    --bucket "$bucket" --key "$key" --query ContentLength --output text) || {
    fail 'managed backup object metadata check failed'
  }
  remote_size=$(printf '%s' "$remote_size" | tr -d '[:space:]')
  printf '%s' "$remote_size"
}

create_backup() {
  new_work
  wait_for_postgres
  backup_id=$(date -u '+%Y%m%dT%H%M%SZ')
  valid_backup_id "$backup_id" || fail 'generated backup ID is invalid'
  database_key="${backup_prefix}${backup_id}/postgres.dump"
  objects_prefix="${backup_prefix}${backup_id}/objects/"
  objects_data_prefix="${objects_prefix}data/"
  objects_manifest_key="${objects_prefix}manifest.json"
  manifest_key="${backup_prefix}${backup_id}/manifest.json"

  compose exec -T postgres pg_dump \
    -U hyfens \
    -d hyfens \
    --format=custom \
    --no-owner \
    --no-acl > "$work/postgres.dump" 2> "$work/pg_dump.stderr" || {
    fail 'public PostgreSQL dump failed'
  }
  [ -s "$work/postgres.dump" ] || fail 'public PostgreSQL dump is empty'
  restore_list "$work/postgres.dump" || {
    fail 'public PostgreSQL dump did not pass pg_restore --list'
  }

  install -d -o root -g root -m 0700 "$work/objects"
  run_aws source s3 sync "s3://$source_bucket" /backup/objects \
    --exclude 'operational/*' --only-show-errors
  write_object_manifest
  verify_object_manifest "$work/objects-manifest.json" "$work/objects" || {
    fail 'source R2 object snapshot failed manifest verification'
  }
  write_manifests "$backup_id"

  run_aws destination s3 cp /backup/postgres.dump \
    "s3://$destination_bucket/$database_key" --only-show-errors
  run_aws destination s3 sync /backup/objects \
    "s3://$destination_bucket/$objects_data_prefix" --only-show-errors
  run_aws destination s3 cp /backup/objects-manifest.json \
    "s3://$destination_bucket/$objects_manifest_key" --only-show-errors
  run_aws destination s3 cp /backup/manifest.json \
    "s3://$destination_bucket/$manifest_key" --only-show-errors

  database_size=$(wc -c < "$work/postgres.dump" | tr -d '[:space:]')
  objects_manifest_size=$(wc -c < "$work/objects-manifest.json" | tr -d '[:space:]')
  remote_database_size=$(head_size destination "$destination_bucket" "$database_key")
  [ "$remote_database_size" = "$database_size" ] || {
    fail 'managed PostgreSQL backup size verification failed'
  }
  remote_objects_manifest_size=$(head_size destination "$destination_bucket" "$objects_manifest_key")
  [ "$remote_objects_manifest_size" = "$objects_manifest_size" ] || {
    fail 'managed object manifest size verification failed'
  }
  head_size destination "$destination_bucket" "$manifest_key" >/dev/null

  run_aws destination s3 cp \
    "s3://$destination_bucket/$database_key" /backup/readback.dump \
    --only-show-errors
  readback_database_sha=$(sha256sum "$work/readback.dump" | awk '{print $1}')
  database_sha=$(sha256sum "$work/postgres.dump" | awk '{print $1}')
  [ "$readback_database_sha" = "$database_sha" ] || {
    fail 'managed PostgreSQL read-back checksum verification failed'
  }
  run_aws destination s3 cp \
    "s3://$destination_bucket/$objects_manifest_key" /backup/readback-objects-manifest.json \
    --only-show-errors
  readback_objects_sha=$(sha256sum "$work/readback-objects-manifest.json" | awk '{print $1}')
  objects_sha=$(sha256sum "$work/objects-manifest.json" | awk '{print $1}')
  [ "$readback_objects_sha" = "$objects_sha" ] || {
    fail 'managed object manifest read-back checksum verification failed'
  }
  install -d -o root -g root -m 0700 "$work/readback-objects"
  run_aws destination s3 sync \
    "s3://$destination_bucket/$objects_data_prefix" /backup/readback-objects \
    --only-show-errors
  verify_object_manifest "$work/readback-objects-manifest.json" \
    "$work/readback-objects" || {
    fail 'managed object read-back checksum verification failed'
  }

  object_count=$(python3 - "$work/objects-manifest.json" <<'PY'
import json
import sys
with open(sys.argv[1], encoding="utf-8") as source:
    print(len(json.load(source)["objects"]))
PY
)
  echo 'managed_public_backup=PASS'
  echo "backup_id=$backup_id"
  echo "database_dump_size_bytes=$database_size"
  echo "database_dump_sha256=sha256:$database_sha"
  echo "object_count=$object_count"
  echo "object_manifest_sha256=sha256:$objects_sha"
  echo 'policy_prefix=operational/'
  echo 'retention_days=30'
}

list_backups() {
  new_work
  object_listing=$(run_aws destination s3api list-objects-v2 \
    --bucket "$destination_bucket" --prefix "$backup_prefix" \
    --query 'Contents[].Key' --output text)
  printf '%s\n' "$object_listing" | tr '\t' '\n'
}

check_freshness() {
  new_work
  object_listing=$(run_aws destination s3api list-objects-v2 \
    --bucket "$destination_bucket" --prefix "$backup_prefix" \
    --query 'Contents[].Key' --output text)
  manifest_keys=$(printf '%s\n' "$object_listing" | tr '\t' '\n' \
    | grep -E '^operational/public-control-plane/[0-9]{8}T[0-9]{6}Z/manifest\.json$' \
    | sort || true)
  latest_manifest=$(printf '%s\n' "$manifest_keys" | tail -n 1)
  [ -n "$latest_manifest" ] || fail 'no public managed backup manifest found'
  backup_id=${latest_manifest#"$backup_prefix"}
  backup_id=${backup_id%/manifest.json}
  valid_backup_id "$backup_id" || fail 'latest public backup ID is invalid'
  run_aws destination s3 cp \
    "s3://$destination_bucket/$latest_manifest" /backup/manifest.json \
    --only-show-errors
  values=$(manifest_values "$work/manifest.json" "$backup_id") || {
    fail 'public managed backup manifest validation failed'
  }
  old_ifs=$IFS
  IFS='	'
  set -- $values
  IFS=$old_ifs
  [ "$#" -eq 8 ] || fail 'public managed backup manifest fields are invalid'
  database_key=$1
  database_sha=$2
  database_size=$3
  objects_manifest_key=$4
  objects_sha=$5
  objects_size=$6
  object_count=$7
  age_seconds=$8
  [ "$age_seconds" -le "$max_age" ] || {
    fail "public managed backup is stale (age_seconds=$age_seconds)"
  }
  remote_database_size=$(head_size destination "$destination_bucket" "$database_key")
  [ "$remote_database_size" = "$database_size" ] || {
    fail 'latest public managed PostgreSQL backup size is invalid'
  }
  remote_objects_size=$(head_size destination "$destination_bucket" "$objects_manifest_key")
  [ "$remote_objects_size" = "$objects_size" ] || {
    fail 'latest public managed object manifest size is invalid'
  }
  echo 'managed_public_backup_freshness=PASS'
  echo "backup_id=$backup_id"
  echo "age_seconds=$age_seconds"
  echo "object_count=$object_count"
  echo "database_sha256=sha256:$database_sha"
  echo "object_manifest_sha256=sha256:$objects_sha"
}

case "$operation" in
  create) create_backup ;;
  list) list_backups ;;
  check-freshness) check_freshness ;;
esac
