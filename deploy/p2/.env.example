# Non-secret control-plane settings
# Discovery identity (non-secret)
HYFENS_DISCOVERY_PRODUCT=hyfens
HYFENS_DISCOVERY_PRODUCT_VERSION=0.1.0
HYFENS_DISCOVERY_API_VERSION=v1
HYFENS_AUTH_ISSUER=
HYFENS_AUTH_AUDIENCE=
HYFENS_AUTH_ACCESS_TTL=
HYFENS_AUTH_SESSION_TTL=
HYFENS_AUTH_CODE_TTL=
HYFENS_AUTH_DEVICE_TTL=
HYFENS_AUTH_DEVICE_POLL_INTERVAL=
HYFENS_AUTH_DEVICE_MAX_ATTEMPTS=
HYFENS_AUTH_DEVICE_ATTEMPTS_PER_MINUTE=
HYFENS_AUTH_ALLOWED_REDIRECT_URIS=
HYFENS_AUTH_DEVICE_VERIFICATION_URI=
HYFENS_AUTH_AUTHORIZATION_ENDPOINT=
# Local Docker only; leave unset/false for every remote deployment.
HYFENS_AUTH_ALLOW_INSECURE_HTTP=
HYFENS_WEB_ORIGINS=
HYFENS_PUBLIC_CONTENT_ORGANIZATION_ID=
# Required to enable public client registration; callers cannot choose it.
HYFENS_PUBLIC_REGISTRATION_ORGANIZATION_ID=
HYFENS_API_BASE_PATH=/

# Optional managed Cloud billing configuration. Keep real values in the
# protected deployment environment; the default development stack is
# self-hosted and must leave these empty.
HYFENS_DEPLOYMENT_MODEL=self_hosted
HYFENS_BILLING_PROVIDER_TOKEN_HASH=
HYFENS_RAZORPAY_STARTER_PLAN_ID=
HYFENS_RAZORPAY_TEAM_PLAN_ID=
HYFENS_RAZORPAY_WEBHOOK_SECRET=
HYFENS_RAZORPAY_CURRENCY=
HYFENS_RAZORPAY_STARTER_AMOUNT_MINOR=
HYFENS_RAZORPAY_TEAM_AMOUNT_MINOR=
# Managed Cloud only; use the reviewed policy value (launch default: 7d).
HYFENS_DELETION_GRACE_PERIOD=

# Keep the auth signing seed outside the repository and inject it through the
# deployment secret mechanism. The value is base64-encoded Ed25519 seed bytes.
HYFENS_AUTH_SIGNING_KEY=
HYFENS_AUTH_SIGNING_KEY_ID=
HYFENS_AUTH_VERIFY_KEYS=

# Managed transactional notifications. Keep secrets in protected deployment
# configuration; these placeholders are intentionally empty/non-secret only.
KEPLARS_API_KEY=
KEPLARS_WEBHOOK_SECRET=
HYFENS_EMAIL_FROM=no-reply@hyfens.com
HYFENS_EMAIL_FROM_NAME=Hyfens
HYFENS_NOTIFICATION_PAYLOAD_KEY=
