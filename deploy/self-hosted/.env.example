# Copy this file to .env and replace every REPLACE_* value.
# Keep .env private; it contains database, object-store, and auth secrets.

# Use the exact version published by a matching Git tag, without the v.
HYFENS_VERSION=REPLACE_VERSION
HYFENS_CONTROL_PLANE_IMAGE=ghcr.io/hyfens-hq/hyfens-control-plane
HYFENS_DASHBOARD_IMAGE=ghcr.io/hyfens-hq/hyfens-dashboard

# Public HTTPS addresses after the host reverse proxy is configured.
HYFENS_DASHBOARD_API_BASE=https://api.example.com/
HYFENS_WEB_ORIGINS=https://app.example.com
HYFENS_AUTH_AUTHORIZATION_ENDPOINT=https://app.example.com/cli/authorize/
HYFENS_AUTH_DEVICE_VERIFICATION_URI=https://app.example.com/device/
HYFENS_AUTH_ALLOWED_REDIRECT_URIS=[]

# Generate URL-safe values with: openssl rand -hex 32
HYFENS_POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD
HYFENS_S3_ACCESS_KEY=hyfens-self-hosted
HYFENS_S3_SECRET_KEY=REPLACE_S3_SECRET

# Generate with: openssl rand -base64 32
HYFENS_AUTH_SIGNING_KEY=REPLACE_BASE64_ED25519_SEED
HYFENS_AUTH_SIGNING_KEY_ID=auth-ed25519-1
HYFENS_AUTH_ISSUER=hyfens-control-plane
HYFENS_AUTH_AUDIENCE=hyfens-control

# Optional public registration/content tenants. Leave empty to disable them.
HYFENS_PUBLIC_REGISTRATION_ORGANIZATION_ID=
HYFENS_PUBLIC_CONTENT_ORGANIZATION_ID=

# Bind both application ports to loopback. The host reverse proxy is the
# public HTTPS boundary; do not change this to 0.0.0.0 without a clear reason.
HYFENS_BIND_ADDRESS=127.0.0.1
HYFENS_CONTROL_PLANE_PORT=18082
HYFENS_DASHBOARD_PORT=18083
